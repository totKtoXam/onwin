    "Apple просит принять соглашение Apple Developer: откройте developer.apple.com/account и примите его. (%@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple asks you to accept the Apple Developer agreement: open developer.apple.com/account and accept it. (%@)"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple сізден Apple Developer келісімін қабылдауды сұрайды: developer.apple.com/account бетін ашып, оны қабылдаңыз. (%@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 要求接受 Apple Developer 协议：请打开 developer.apple.com/account 并接受协议。（%@）"
          }
        }
      }
    },
    "Arial, Times New Roman, Courier New, Verdana, Georgia и другие — для правильного текста в играх и программах" : {
      "localizations" : {
