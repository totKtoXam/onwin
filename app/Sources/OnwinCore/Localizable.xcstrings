    "Контрольная сумма %@ не совпадает с рецептом.\nОжидалось: %@\nПолучено: %@\nИздатель мог обновить файл — проверьте ссылку и обновите SHA-256 в рецепте." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The checksum of %@ doesn’t match the recipe.\nExpected: %@\nGot: %@\nThe publisher may have updated the file — check the link and update the SHA-256 in the recipe."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ бақылау сомасы рецептке сәйкес келмейді.\nКүтілгені: %@\nАлынғаны: %@\nЖариялаушы файлды жаңартқан болуы мүмкін — сілтемені тексеріп, рецепттегі SHA-256 мәнін жаңартыңыз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的校验和与配方不一致。\n预期：%@\n实际：%@\n发布者可能更新了文件 — 请检查链接并更新配方中的 SHA-256。"
          }
        }
      }
    },
    "Копирование закончилось, но D3DMetal не найден в %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copying finished, but D3DMetal wasn’t found in %@"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
