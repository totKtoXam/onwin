    "%@ ставится один раз для всех пространств: используйте «Установить D3DMetal» в каталоге onwin или onwinctl d3dmetal-fetch." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is installed once for all spaces: use “Install D3DMetal” in the onwin Catalog or onwinctl d3dmetal-fetch."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ барлық кеңістік үшін бір рет орнатылады: onwin каталогындағы «D3DMetal орнату» батырмасын немесе onwinctl d3dmetal-fetch пәрменін пайдаланыңыз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 只需为所有空间安装一次：请使用 onwin 目录中的“安装 D3DMetal”或 onwinctl d3dmetal-fetch。"
          }
        }
      }
    },
    "%@ уже скачан" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
