    "64-битные XAudio/XACT не ставятся: в Wine они ломают звук (как в winetricks)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "64-bit XAudio/XACT are not installed: in Wine they break sound (same as in winetricks)."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "64-биттік XAudio/XACT орнатылмайды: Wine ішінде олар дыбысты бұзады (winetricks сияқты)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不安装 64 位 XAudio/XACT：在 Wine 中它们会导致声音异常（与 winetricks 的做法相同）。"
          }
        }
