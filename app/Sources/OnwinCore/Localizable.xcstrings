    "DirectX 11/12 → Metal от Apple: нужен играм на DirectX 12. onwin сам скачает его с сайта Apple после входа с Apple ID" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DirectX 11/12 → Metal by Apple: needed for DirectX 12 games. onwin downloads it from Apple’s website after you sign in with your Apple ID"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DirectX 11/12 → Apple жасаған Metal: DirectX 12 ойындарына керек. Apple ID арқылы кіргеннен кейін onwin оны Apple сайтынан өзі жүктеп алады"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 的 DirectX 11/12 → Metal 转换：DirectX 12 游戏需要它。使用 Apple ID 登录后，onwin 会自动从 Apple 网站下载"
          }
        }
      }
    },
    "DirectX 11/12 → Metal, лучший для новых игр" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DirectX 11/12 → Metal, best for new games"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DirectX 11/12 → Metal, жаңа ойындар үшін ең жақсысы"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DirectX 11/12 → Metal，新游戏的最佳选择"
          }
        }
      }
    },
    "DirectX → OpenGL, самый совместимый" : {
      "localizations" : {
        "en" : {
