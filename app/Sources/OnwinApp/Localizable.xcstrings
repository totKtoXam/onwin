          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» әлі Steam ішінде жүктелуде — жүктеу аяқталғанда іске қосуға болады."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
