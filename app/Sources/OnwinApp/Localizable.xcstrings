    },
    "Двойной щелчок — играть через Steam" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-click to play through Steam"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
