{
  "sourceLanguage" : "ru",
  "strings" : {
    "%@\n%@ — двойной щелчок запускает" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n%@ — double-click to run"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n%@ — іске қосу үшін екі рет басыңыз"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n%@ — 双击运行"
          }
        }
      }
    },
    "%@\nSteam App %lld — двойной щелчок запускает через Steam" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSteam App %lld — double-click to run through Steam"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSteam App %lld — Steam арқылы іске қосу үшін екі рет басыңыз"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSteam App %lld — 双击通过 Steam 运行"
          }
        }
      }
    },
    "%@\nМожно установить вручную в Терминале: softwareupdate --install-rosetta --agree-to-license" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nYou can install it manually in Terminal: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nТерминалда қолмен орнатуға болады: softwareupdate --install-rosetta --agree-to-license"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n也可以在“终端”中手动安装：softwareupdate --install-rosetta --agree-to-license"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "Desktop summary: «5 программ» + «в 2 пространствах»",
      "shouldTranslate" : false
    },
    "%@ · Wine %@" : {
      "shouldTranslate" : false
    },
    "%@ копия" : {
      "comment" : "Name of a duplicated space",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ copy"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ көшірмесі"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 副本"
          }
        }
      }
    },
    "%@ не найден в пространстве «%@»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wasn’t found in the space “%@”."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ «%@» кеңістігінде табылмады."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在空间“%2$@”中找不到 %1$@。"
          }
        }
      }
    },
    "%@ недоступен (%@). Сейчас будет использован %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn’t available (%@). %@ will be used instead."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ қолжетімсіз (%@). Оның орнына %@ қолданылады."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不可用（%@）。现在将使用 %@。"
          }
        }
      }
    },
    "%@ недоступен, вместо него используется %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn’t available, %@ is used instead"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ қолжетімсіз, оның орнына %@ қолданылуда"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不可用，改用 %@"
          }
        }
      }
    },
    "%@ недоступен: %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn’t available: %@."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ қолжетімсіз: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不可用：%@。"
          }
        }
      }
    },
    "%@ недоступен: %@. Программа получит %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn’t available: %@. The program will use %@."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ қолжетімсіз: %@. Бағдарламаға %@ беріледі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不可用：%@。程序将使用 %@。"
          }
        }
      }
    },
    "%@ уже есть в «%@». Повторная установка его переустановит." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is already in “%@”. Installing it again will reinstall it."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ бұрыннан «%@» ішінде бар. Қайта орнатсаңыз, ол қайтадан орнатылады."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已存在于“%@”中。再次安装会重新安装它。"
          }
        }
      }
    },
    "%@ уже работает — повторный запуск обычно выводит окно программы вперёд (⌘↩)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is already running — launching it again usually brings the program’s window to the front (⌘↩)"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ жұмыс істеп тұр — қайта іске қосу әдетте бағдарлама терезесін алдыңғы жоспарға шығарады (⌘↩)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在运行 — 再次运行通常会把程序窗口调到前面（⌘↩）"
          }
        }
      }
    },
