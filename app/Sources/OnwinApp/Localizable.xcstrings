            "value" : "Қысқаша, каталогтағы тақтайша үшін"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简短描述，用于目录中的卡片"
          }
        }
      }
    },
    "Куда установить?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
