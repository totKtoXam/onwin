      }
    },
    "Каналы WINEDEBUG" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WINEDEBUG Channels"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WINEDEBUG арналары"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WINEDEBUG 通道"
          }
        }
      }
    },
    "Каналы через запятую: +канал включает, -канал выключает. Журнал запуска — в «Журналах» пространства." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comma-separated channels: +channel turns one on, -channel turns it off. The launch log is in the space’s “Logs”."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Арналар үтір арқылы: +арна қосады, -арна өшіреді. Іске қосу журналы — кеңістіктің «Журналдар» бөлімінде."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多个通道用逗号分隔：+通道 表示开启，-通道 表示关闭。运行日志在空间的“日志”中。"
          }
        }
      }
    },
    "Каталог" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catalog"
          }
        },
        "kk" : {
