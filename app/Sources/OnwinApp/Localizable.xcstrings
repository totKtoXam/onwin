    "Что нового" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What’s New"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не жаңалық"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新功能"
          }
        }
      }
    },
    "Что сделать" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What to do"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не істеу керек"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要做什么"
          }
        }
      }
