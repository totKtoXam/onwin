    },
    "Папки «Документы», «Загрузки» и другие можно поменять, только пока в пространстве ничего не запущено." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Documents, Downloads and other folders can be changed only while nothing is running in the space."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Құжаттар», «Жүктеулер» және басқа қалталарды кеңістікте ештеңе іске қосылмаған кезде ғана өзгертуге болады."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“文档”“下载”等文件夹只能在空间中没有任何程序运行时更改。"
          }
        }
      }
    },
    "Папки пространства" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space Folders"
          }
        },
        "kk" : {
          "stringUnit" : {
