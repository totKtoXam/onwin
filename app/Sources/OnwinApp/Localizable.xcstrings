        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "onwin %@ орнатты («%@» үшін). Бағдарламаны қайта іске қосыңыз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
