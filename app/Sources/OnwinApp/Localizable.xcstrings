    "Apple выдаёт Game Porting Toolkit только после входа с Apple ID. Войдите на странице Apple ниже — дальше onwin всё сделает сам." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple provides Game Porting Toolkit only after you sign in with an Apple ID. Sign in on the Apple page below — onwin will take care of the rest."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Game Porting Toolkit жинағын тек Apple ID арқылы кіргеннен кейін береді. Төмендегі Apple бетінде кіріңіз — қалғанын onwin өзі жасайды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 只在使用 Apple ID 登录后才提供 Game Porting Toolkit。请在下方的 Apple 页面上登录 — 其余步骤 onwin 会自动完成。"
          }
        }
      }
    },
    "Apple пока не отдаёт список загрузок: %@. Завершите вход на странице — onwin проверит ещё раз." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple isn’t providing the downloads list yet: %@. Finish signing in on the page — onwin will check again."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple әзірге жүктеулер тізімін бермей тұр: %@. Беттегі кіруді аяқтаңыз — onwin қайта тексереді."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 暂未返回下载列表：%@。请在页面上完成登录 — onwin 会再检查一次。"
          }
        }
      }
    },
    "Apple просит принять соглашение Apple Developer — примите его на странице ниже." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple asks you to accept the Apple Developer agreement — accept it on the page below."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple сізден Apple Developer келісімін қабылдауды сұрайды — оны төмендегі бетте қабылдаңыз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 要求接受 Apple Developer 协议 — 请在下方页面上接受。"
          }
        }
      }
    },
    "C:\\Program Files\\Программа\\app.exe" : {
      "localizations" : {
