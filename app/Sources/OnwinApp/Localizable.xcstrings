    "Пространство «%@» ещё не готово (нет system.reg). Создайте его заново." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space “%@” isn’t ready yet (no system.reg). Create it again."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» кеңістігі әлі дайын емес (system.reg жоқ). Оны қайта жасаңыз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空间“%@”尚未准备好（缺少 system.reg）。请重新创建它。"
          }
        }
      }
    },
    "Пространство «%@» сейчас работает" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space “%@” is running"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» кеңістігі қазір жұмыс істеп тұр"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空间“%@”正在运行"
          }
        }
      }
    },
    "Пространство «%@» уже есть" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space “%@” already exists"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» кеңістігі бұрыннан бар"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
