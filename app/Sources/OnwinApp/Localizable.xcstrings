          }
        }
      }
    },
    "Коротко, для карточки в каталоге" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short, for the card in the Catalog"
          }
        },
        "kk" : {
