          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "onwin Game Porting Toolkit соңғы тұрақты нұсқасын өзі тауып, жүктеп алады (үзілген жүктеу сол жерден жалғасады)."
          }
