            "value" : "“%@” exited with code %lld right after launch. See the log for details."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» іске қосылғаннан кейін бірден %lld кодымен аяқталды. Толығырақ — журналда."
          }
        },
        "zh-Hans" : {
