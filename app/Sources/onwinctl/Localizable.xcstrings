          "stringUnit" : {
            "state" : "translated",
            "value" : "кеңістіктегі бағдарлама жабылудан бас тартты; оны өзіңіз жабыңыз немесе: onwinctl kill %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
