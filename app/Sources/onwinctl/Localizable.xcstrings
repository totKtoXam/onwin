    "mac-folders: on (связать с папками Mac) или off (свои папки пространства)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mac-folders: on (link to Mac folders) or off (the space’s own folders)"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mac-folders: on (Mac қалталарымен байланыстыру) немесе off (кеңістіктің өз қалталары)"
          }
        },
        "zh-Hans" : {
