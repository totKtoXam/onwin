    "id «%@» занят встроенным рецептом каталога — выберите другой" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "id “%@” is already used by a built-in Catalog recipe — choose another one"
          }
        },
        "kk" : {
